---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import TopicBreadcrumbs from '../../components/TopicBreadcrumbs.astro';
import { Card, CardContent, CardHeader, CardTitle } from '../../components/starwind/card';
import {
  collectTopics,
  entryTopicPath,
  getPublishedPosts,
  topicUrl,
} from '../../lib/content';
import { flattenTopicTree, topicBreadcrumbsFromPath, type TopicNode } from '../../lib/topics';

export async function getStaticPaths() {
  const pageSize = 12;
  const entries = await getPublishedPosts();
  const topics = flattenTopicTree(collectTopics(entries));

  return topics.flatMap((topic) => {
    const directEntries = entries.filter((entry) => entryTopicPath(entry) === topic.path);
    const pages = Math.max(1, Math.ceil(directEntries.length / pageSize));

    return Array.from({ length: pages }, (_, index) => ({
      params: {
        path: index === 0 ? topic.path : `${topic.path}/page/${index + 1}`,
      },
      props: {
        topic,
        directEntries,
        page: index + 1,
        pages,
      },
    }));
  });
}

interface Props {
  topic: TopicNode;
  directEntries: Awaited<ReturnType<typeof getPublishedPosts>>;
  page: number;
  pages: number;
}

const { topic, directEntries, page, pages } = Astro.props;
const allEntries = await getPublishedPosts();
const pageSize = 12;
const visibleEntries = directEntries.slice((page - 1) * pageSize, page * pageSize);
const breadcrumbs = topicBreadcrumbsFromPath(topic.path).map((item) => ({
  ...item,
  url: topicUrl(item.path),
}));
const pageTitle = `${topic.name}${page > 1 ? ` ${page}페이지` : ''}`;
---

<BaseLayout
  title={pageTitle}
  description={`${topic.name} 주제의 기술 글 ${topic.count}개`}
  entries={allEntries}
>
  <div class="mx-auto w-[min(calc(100%-2rem),72rem)] pt-13">
    <TopicBreadcrumbs items={breadcrumbs} current />

    <header class="mb-6 flex items-end justify-between gap-4 border-b pb-3">
      <div>
        <span class="text-xs font-bold tracking-[0.08em] text-primary uppercase">Topic</span>
        <h1 class="text-[clamp(1.55rem,4vw,2.35rem)] font-semibold tracking-[-0.045em]">{topic.name}</h1>
      </div>
      <p class="text-muted-foreground">{topic.count}개의 글</p>
    </header>

    {topic.children.length > 0 && (
      <section aria-labelledby="subtopics-title">
        <div class="mt-10 mb-4 flex items-end justify-between gap-4">
          <h2 id="subtopics-title" class="text-xl font-semibold tracking-tight">하위 주제</h2>
          <p class="text-sm text-muted-foreground">{topic.children.length}개</p>
        </div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {topic.children.map((child) => (
            <a class="group block no-underline" href={topicUrl(child.path)}>
              <Card class="min-h-36 justify-between transition-colors group-hover:border-primary/40">
                <CardHeader><CardTitle>{child.name}</CardTitle></CardHeader>
                <CardContent class="text-sm text-muted-foreground group-hover:text-primary-accent">
                  {child.count}개의 글
                  {child.children.length > 0 && ` · ${child.children.length}개 하위 주제`}
                  {' →'}
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
      </section>
    )}

    {directEntries.length > 0 && (
      <section aria-labelledby="topic-posts-title">
        <div class="mt-10 mb-4 flex items-end justify-between gap-4">
          <h2 id="topic-posts-title" class="text-xl font-semibold tracking-tight">
            {topic.children.length > 0 ? '이 주제의 글' : '글'}
          </h2>
          <p class="text-sm text-muted-foreground">{directEntries.length}개</p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {visibleEntries.map((entry) => <PostCard entry={entry} />)}
        </div>
        <Pagination
          current={page}
          total={pages}
          getUrl={(target) => topicUrl(topic.path, target)}
        />
      </section>
    )}
  </div>
</BaseLayout>
