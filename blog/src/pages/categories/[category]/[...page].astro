---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import { categoryUrl, collectCategories, getPublishedPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const pageSize = 12;
  const entries = await getPublishedPosts();
  return collectCategories(entries).flatMap((category) => {
    const categoryEntries = entries.filter((entry) => entry.data.category === category.name);
    const pages = Math.ceil(categoryEntries.length / pageSize);
    return Array.from({ length: pages }, (_, index) => ({
      params: {
        category: category.slug,
        page: index === 0 ? undefined : String(index + 1),
      },
      props: {
        category: category.name,
        entries: categoryEntries,
        page: index + 1,
        pages,
      },
    }));
  });
}

interface Props {
  category: string;
  entries: Awaited<ReturnType<typeof getPublishedPosts>>;
  page: number;
  pages: number;
}

const { category, entries: categoryEntries, page, pages } = Astro.props;
const allEntries = await getPublishedPosts();
const PAGE_SIZE = 12;
const visibleEntries = categoryEntries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
---

<BaseLayout
  title={`${category}${page > 1 ? ` ${page}페이지` : ''}`}
  description={`${category} 카테고리의 기술 글 ${categoryEntries.length}개`}
  entries={allEntries}
>
  <div class="listing-shell">
    <header class="section-header">
      <div>
        <span class="eyebrow">Category</span>
        <h1>{category}</h1>
      </div>
      <p>{categoryEntries.length}개의 글</p>
    </header>
    <div class="post-list">
      {visibleEntries.map((entry) => <PostCard entry={entry} />)}
    </div>
    <Pagination current={page} total={pages} getUrl={(target) => categoryUrl(category, target)} />
  </div>
</BaseLayout>
