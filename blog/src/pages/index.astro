---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { collectCategories, getPublishedPosts, topicUrl } from '../lib/content';
import { withBase } from '../lib/url';

const entries = await getPublishedPosts();
const categories = collectCategories(entries);
const recent = entries.slice(0, 12);
---

<BaseLayout entries={entries}>
  <div class="page-shell">
    <section class="hero">
      <div>
        <span class="eyebrow">Learn in public</span>
        <h1>배우고,<br />만들고, 설명합니다.</h1>
        <p>
          백엔드와 분산 시스템, 데이터베이스, 프론트엔드, AI를 탐구하며
          더 나은 소프트웨어를 만드는 과정을 기록합니다.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#recent-posts">최근 글 보기</a>
          <a class="button" href={withBase('search/')}>글 검색하기</a>
        </div>
      </div>
    </section>

    <section aria-labelledby="categories-title">
      <div class="section-header">
        <h2 id="categories-title">주제별 탐색</h2>
        <p>{entries.length}개의 글</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={topicUrl(category.slug)}>
            <strong>{category.name}</strong>
            <span>{category.count}개의 글 →</span>
          </a>
        ))}
      </div>
    </section>

    <section id="recent-posts" aria-labelledby="recent-title">
      <div class="section-header">
        <h2 id="recent-title">최근 글</h2>
        <a href={withBase('tags/')}>모든 태그 보기</a>
      </div>
      <div class="post-list">
        {recent.map((entry) => <PostCard entry={entry} />)}
      </div>
    </section>
  </div>
</BaseLayout>
