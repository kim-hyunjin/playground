---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts } from '../../lib/content';
import { tagUrl } from '../../lib/content';

const entries = await getPublishedPosts();
const tags = collectTags(entries);
---

<BaseLayout title="태그" description="hyunjin.log의 모든 기술 태그" entries={entries}>
  <div class="listing-shell">
    <header class="section-header">
      <div>
        <span class="eyebrow">Topics</span>
        <h1>태그</h1>
      </div>
      <p>{tags.length}개</p>
    </header>
    <div class="tag-cloud">
      {tags.map((tag) => (
        <a href={tagUrl(tag.name)}>
          <strong>#{tag.name}</strong>
          <span>{tag.count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
