---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import { collectTags, getPublishedPosts, tagSlug, tagUrl } from '../../../lib/content';

export async function getStaticPaths() {
  const pageSize = 12;
  const entries = await getPublishedPosts();
  return collectTags(entries).flatMap((tag) => {
    const tagEntries = entries.filter((entry) =>
      entry.data.tags.some((entryTag) => tagSlug(entryTag) === tag.slug),
    );
    const pages = Math.ceil(tagEntries.length / pageSize);
    return Array.from({ length: pages }, (_, index) => ({
      params: {
        tag: tag.slug,
        page: index === 0 ? undefined : String(index + 1),
      },
      props: {
        tag: tag.name,
        entries: tagEntries,
        page: index + 1,
        pages,
      },
    }));
  });
}

interface Props {
  tag: string;
  entries: Awaited<ReturnType<typeof getPublishedPosts>>;
  page: number;
  pages: number;
}

const { tag, entries: tagEntries, page, pages } = Astro.props;
const allEntries = await getPublishedPosts();
const PAGE_SIZE = 12;
const visibleEntries = tagEntries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
---

<BaseLayout
  title={`#${tag}${page > 1 ? ` ${page}페이지` : ''}`}
  description={`#${tag} 태그가 붙은 기술 글 ${tagEntries.length}개`}
  entries={allEntries}
>
  <div class="mx-auto w-[min(calc(100%-2rem),72rem)] pt-13">
    <header class="mb-6 flex items-end justify-between gap-4 border-b pb-3">
      <div>
        <span class="text-xs font-bold tracking-[0.08em] text-primary uppercase">Tag</span>
        <h1 class="text-[clamp(1.55rem,4vw,2.35rem)] font-semibold tracking-[-0.045em]">#{tag}</h1>
      </div>
      <p class="text-muted-foreground">{tagEntries.length}개의 글</p>
    </header>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {visibleEntries.map((entry) => <PostCard entry={entry} />)}
    </div>
    <Pagination current={page} total={pages} getUrl={(target) => tagUrl(tag, target)} />
  </div>
</BaseLayout>
