---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/url';

const entries = await getPublishedPosts();
const pagefindPath = withBase('pagefind/pagefind.js');
const basePath = withBase();
---

<BaseLayout title="검색" description="hyunjin.log의 글 검색" entries={entries}>
  <div class="search-shell" id="search-shell" data-pagefind-path={pagefindPath} data-base-path={basePath}>
    <header class="section-header">
      <div>
        <span class="eyebrow">Static search</span>
        <h1>검색</h1>
      </div>
      <p>제목, 본문, 태그</p>
    </header>
    <form class="search-form" id="search-form" role="search" data-pagefind-ignore>
      <label class="sr-only" for="search-input">검색어</label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="예: PostgreSQL, 분산 시스템, React"
        autocomplete="off"
      />
      <button class="button primary" type="submit">검색</button>
    </form>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    <ol class="search-results" id="search-results"></ol>
  </div>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    border: 0;
    padding: 0;
    white-space: nowrap;
    clip: rect(0, 0, 0, 0);
  }

  .search-shell {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-top: 3.2rem;
  }

  .search-form {
    display: flex;
    gap: 0.5rem;
    margin-block: 1.5rem 2rem;
  }

  .search-form input {
    min-width: 0;
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 0.55rem;
    padding: 0.8rem 1rem;
    background: var(--surface);
    color: var(--text);
  }

  .search-status {
    color: var(--muted);
  }

  .search-results {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }

  .search-results :global(a) {
    display: block;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    padding: 1rem;
    background: var(--surface);
    text-decoration: none;
  }

  .search-results :global(h2) {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }

  .search-results :global(p) {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.88rem;
  }

  .search-results :global(mark) {
    background: #ffe49a;
    color: #141413;
  }
</style>

<script is:inline>
  const form = document.querySelector('#search-form');
  const input = document.querySelector('#search-input');
  const status = document.querySelector('#search-status');
  const list = document.querySelector('#search-results');
  const shell = document.querySelector('#search-shell');
  const pagefindPath = shell.dataset.pagefindPath;
  const basePath = shell.dataset.basePath;
  let pagefind;

  const escapeHtml = (value) =>
    String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');

  async function loadPagefind() {
    if (pagefind) return pagefind;
    pagefind = await import(pagefindPath);
    await pagefind.options({ baseUrl: basePath });
    return pagefind;
  }

  async function search(query) {
    if (!query.trim()) {
      status.textContent = '검색어를 입력하세요.';
      list.replaceChildren();
      return;
    }
    status.textContent = '검색 중…';
    try {
      const api = await loadPagefind();
      const search = await api.search(query);
      const results = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
      list.innerHTML = results
        .map((result) => `
          <li>
            <a href="${escapeHtml(result.url)}">
              <h2>${escapeHtml(result.meta.title)}</h2>
              <p>${result.excerpt}</p>
            </a>
          </li>
        `)
        .join('');
      status.textContent = `${search.results.length}개의 결과`;
    } catch (error) {
      console.error(error);
      status.textContent = '검색 인덱스는 production build 후 사용할 수 있습니다.';
    }
  }

  const query = new URLSearchParams(location.search).get('q') || '';
  input.value = query;
  if (query) search(query);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const next = input.value.trim();
    history.replaceState(null, '', next ? `?q=${encodeURIComponent(next)}` : location.pathname);
    search(next);
  });
</script>
