---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/starwind/button';
import { Input } from '../components/starwind/input';
import { getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/url';

const entries = await getPublishedPosts();
const pagefindPath = withBase('pagefind/pagefind.js');
const basePath = withBase();
---

<BaseLayout title="검색" description="hyunjin.log의 글 검색" entries={entries}>
  <div class="mx-auto w-[min(calc(100%-2rem),72rem)] pt-13" id="search-shell" data-pagefind-path={pagefindPath} data-base-path={basePath}>
    <header class="mb-6 flex items-end justify-between gap-4 border-b pb-3">
      <div>
        <span class="text-xs font-bold tracking-[0.08em] text-primary uppercase">Static search</span>
        <h1 class="text-[clamp(1.55rem,4vw,2.35rem)] font-semibold tracking-[-0.045em]">검색</h1>
      </div>
      <p class="text-muted-foreground">제목, 본문, 태그</p>
    </header>
    <form class="my-6 flex gap-2" id="search-form" role="search" data-pagefind-ignore>
      <label class="sr-only" for="search-input">검색어</label>
      <Input
        class="min-w-0 flex-1"
        id="search-input"
        name="q"
        type="search"
        placeholder="예: PostgreSQL, 분산 시스템, React"
        autocomplete="off"
      />
      <Button variant="primary" type="submit">검색</Button>
    </form>
    <p class="text-muted-foreground" id="search-status" aria-live="polite"></p>
    <ol class="search-results my-4 grid list-none gap-3 p-0" id="search-results"></ol>
  </div>
</BaseLayout>

<script is:inline>
  const form = document.querySelector('#search-form');
  const input = document.querySelector('#search-input');
  const status = document.querySelector('#search-status');
  const list = document.querySelector('#search-results');
  const shell = document.querySelector('#search-shell');
  const pagefindPath = shell.dataset.pagefindPath;
  const basePath = shell.dataset.basePath;
  let pagefind;

  const escapeHtml = (value) =>
    String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');

  async function loadPagefind() {
    if (pagefind) return pagefind;
    pagefind = await import(pagefindPath);
    await pagefind.options({ baseUrl: basePath });
    return pagefind;
  }

  async function search(query) {
    if (!query.trim()) {
      status.textContent = '검색어를 입력하세요.';
      list.replaceChildren();
      return;
    }
    status.textContent = '검색 중…';
    try {
      const api = await loadPagefind();
      const search = await api.search(query);
      const results = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
      list.innerHTML = results
        .map((result) => `
          <li>
            <a class="block rounded-xl border bg-card p-5 text-card-foreground no-underline shadow-xs transition-colors hover:border-primary/35" href="${escapeHtml(result.url)}">
              <h2 class="mb-1.5 text-lg font-medium">${escapeHtml(result.meta.title)}</h2>
              <p class="m-0 text-sm text-muted-foreground">${result.excerpt}</p>
            </a>
          </li>
        `)
        .join('');
      status.textContent = `${search.results.length}개의 결과`;
    } catch (error) {
      console.error(error);
      status.textContent = '검색 인덱스는 production build 후 사용할 수 있습니다.';
    }
  }

  const query = new URLSearchParams(location.search).get('q') || '';
  input.value = query;
  if (query) search(query);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const next = input.value.trim();
    history.replaceState(null, '', next ? `?q=${encodeURIComponent(next)}` : location.pathname);
    search(next);
  });
</script>
