---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/url';

const entries = await getPublishedPosts();
---

<BaseLayout title="페이지를 찾을 수 없습니다" entries={entries}>
  <section class="not-found">
    <div>
      <strong>404</strong>
      <h1>길을 잃었습니다.</h1>
      <p>주소가 바뀌었거나 존재하지 않는 페이지입니다.</p>
      <a class="button primary" href={withBase()}>홈으로 돌아가기</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 65vh;
    place-items: center;
    text-align: center;
  }

  .not-found strong {
    display: block;
    color: var(--brand);
    font-family: var(--font-mono);
  }

  .not-found h1 {
    margin: 0.4rem;
    font-size: clamp(2rem, 7vw, 4rem);
  }
</style>
