---
import BaseLayout from '../layouts/BaseLayout.astro';
import SitemapTopic from '../components/SitemapTopic.astro';
import { collectTopics, getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/url';

const entries = await getPublishedPosts();
const topics = collectTopics(entries);
---

<BaseLayout
  title="사이트맵"
  description="주제별로 정리한 hyunjin.log의 전체 글과 주요 페이지"
  entries={entries}
>
  <div class="listing-shell sitemap-shell">
    <header class="section-header">
      <div>
        <span class="eyebrow">Sitemap</span>
        <h1>사이트맵</h1>
      </div>
      <p>{entries.length}개의 글</p>
    </header>

    <p class="sitemap-intro">
      관심 있는 주제를 따라가거나 전체 글을 한눈에 살펴보세요. 검색엔진용 XML
      sitemap도 별도로 제공됩니다.
    </p>

    <nav class="sitemap-primary" aria-label="주요 페이지">
      <a href={withBase()}>홈</a>
      <a href={withBase('search/')}>검색</a>
      <a href={withBase('tags/')}>전체 태그</a>
      <a href={withBase('rss.xml')}>RSS</a>
      <a href={withBase('sitemap-index.xml')}>XML Sitemap</a>
    </nav>

    <nav aria-label="주제와 글">
      <ul class="sitemap-tree">
        {topics.map((topic) => (
          <SitemapTopic topic={topic} entries={entries} />
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .sitemap-shell {
    padding-bottom: 2rem;
  }

  .sitemap-intro {
    max-width: 42rem;
    margin: 0 0 1.5rem;
    color: var(--text-soft);
  }

  .sitemap-primary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .sitemap-primary a {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.42rem 0.8rem;
    background: var(--surface);
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .sitemap-primary a:hover {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .sitemap-tree {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sitemap-tree > :global(.sitemap-topic) {
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    padding: 1.2rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
</style>
