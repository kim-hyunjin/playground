---
import BaseLayout from '../layouts/BaseLayout.astro';
import SitemapTopic from '../components/SitemapTopic.astro';
import { Button } from '../components/starwind/button';
import { Card, CardContent } from '../components/starwind/card';
import { collectTopics, getPublishedPosts } from '../lib/content';
import { withBase } from '../lib/url';

const entries = await getPublishedPosts();
const topics = collectTopics(entries);
---

<BaseLayout
  title="사이트맵"
  description="주제별로 정리한 hyunjin.log의 전체 글과 주요 페이지"
  entries={entries}
>
  <div class="mx-auto w-[min(calc(100%-2rem),72rem)] pt-13 pb-8">
    <header class="mb-6 flex items-end justify-between gap-4 border-b pb-3">
      <div>
        <span class="text-xs font-bold tracking-[0.08em] text-primary uppercase">Sitemap</span>
        <h1 class="text-[clamp(1.55rem,4vw,2.35rem)] font-semibold tracking-[-0.045em]">사이트맵</h1>
      </div>
      <p class="text-muted-foreground">{entries.length}개의 글</p>
    </header>

    <p class="mb-6 max-w-2xl text-muted-foreground">
      관심 있는 주제를 따라가거나 전체 글을 한눈에 살펴보세요. 검색엔진용 XML
      sitemap도 별도로 제공됩니다.
    </p>

    <nav class="mb-8 flex flex-wrap gap-2" aria-label="주요 페이지">
      <Button as="a" variant="outline" size="sm" href={withBase()}>홈</Button>
      <Button as="a" variant="outline" size="sm" href={withBase('search/')}>검색</Button>
      <Button as="a" variant="outline" size="sm" href={withBase('tags/')}>전체 태그</Button>
      <Button as="a" variant="outline" size="sm" href={withBase('rss.xml')}>RSS</Button>
      <Button as="a" variant="outline" size="sm" href={withBase('sitemap-index.xml')}>XML Sitemap</Button>
    </nav>

    <nav aria-label="주제와 글">
      <ul class="grid list-none gap-4 p-0">
        {topics.map((topic) => (
          <li>
            <Card>
              <CardContent><SitemapTopic topic={topic} entries={entries} /></CardContent>
            </Card>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
