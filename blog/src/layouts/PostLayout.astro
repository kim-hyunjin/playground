---
import type { MarkdownHeading } from 'astro';
import type { BlogEntry } from '../lib/content';
import BaseLayout from './BaseLayout.astro';
import Mermaid from '../components/Mermaid.astro';
import TopicBreadcrumbs from '../components/TopicBreadcrumbs.astro';
import { entryTopicBreadcrumbs, entryUrl, tagUrl } from '../lib/content';

interface Props {
  entry: BlogEntry;
  entries: BlogEntry[];
  headings: MarkdownHeading[];
  previous?: BlogEntry;
  next?: BlogEntry;
}

const { entry, entries, headings, previous, next } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const topicBreadcrumbs = entryTopicBreadcrumbs(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? entry.data.summary}
  entries={entries}
  canonical={entry.data.canonical}
  type="article"
>
  <div class="post-shell">
    <article class="post-article">
      <header class="post-header">
        <TopicBreadcrumbs items={topicBreadcrumbs} />
        <h1 data-pagefind-meta="title">{entry.data.title}</h1>
        <p class="post-summary">{entry.data.summary}</p>
        <div class="post-byline">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('ko-KR', { dateStyle: 'long' })}
          </time>
        </div>
      </header>

      {toc.length > 0 && (
        <details class="mobile-toc" data-pagefind-ignore>
          <summary>목차</summary>
          <ol>
            {toc.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <div class="prose" data-pagefind-body>
        <slot />
      </div>

      <footer class="post-footer">
        <ul class="tag-list" aria-label="태그">
          {entry.data.tags.map((tag) => (
            <li><a href={tagUrl(tag)}>#{tag}</a></li>
          ))}
        </ul>
        <nav class="post-navigation" aria-label="이전과 다음 글">
          {previous ? (
            <a rel="prev" href={entryUrl(previous)}>
              <small>이전 글</small>
              <span>← {previous.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a rel="next" href={entryUrl(next)}>
              <small>다음 글</small>
              <span>{next.data.title} →</span>
            </a>
          ) : <span />}
        </nav>
      </footer>
    </article>

    {toc.length > 0 && (
      <aside class="toc" aria-label="목차" data-pagefind-ignore>
        <strong>목차</strong>
        <ol>
          {toc.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>

  <Mermaid />
</BaseLayout>

<style>
  .post-shell {
    display: grid;
    width: min(100% - 2rem, 77rem);
    margin: 0 auto;
    grid-template-columns: minmax(0, 48rem) 15rem;
    justify-content: center;
    gap: 4rem;
  }

  .post-article {
    min-width: 0;
    padding-top: 4rem;
  }

  .post-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }

  .post-header h1 {
    margin: 0.6rem 0 1rem;
    font-size: clamp(2.15rem, 5.6vw, 3.65rem);
    font-weight: 650;
    letter-spacing: -0.042em;
    line-height: 1.1;
    overflow-wrap: break-word;
    word-break: keep-all;
  }

  .post-summary {
    color: var(--text-soft);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .post-byline {
    display: flex;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .toc {
    position: sticky;
    top: 6rem;
    align-self: start;
    max-height: calc(100vh - 8rem);
    margin-top: 4rem;
    overflow: auto;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .toc strong {
    color: var(--text);
  }

  .toc ol {
    margin: 0.7rem 0;
    padding: 0;
    list-style: none;
  }

  .toc li + li {
    margin-top: 0.4rem;
  }

  .toc li.nested {
    padding-left: 0.8rem;
  }

  .toc a {
    text-decoration: none;
  }

  .mobile-toc {
    display: none;
  }

  .prose {
    color: var(--text);
    font-size: 1.0625rem;
    letter-spacing: -0.005em;
    line-height: 1.82;
    overflow-wrap: anywhere;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    position: relative;
    margin: 2.5em 0 0.75em;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
    overflow-wrap: break-word;
    scroll-margin-top: 6rem;
    word-break: keep-all;
  }

  .prose :global(h1) {
    font-size: 2.15rem;
  }

  .prose :global(h2) {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.35em;
    font-size: 1.7rem;
  }

  .prose :global(h3) {
    font-size: 1.35rem;
  }

  .prose :global(h4) {
    font-size: 1.12rem;
  }

  .prose :global(.heading-anchor) {
    margin-left: 0.4em;
    color: var(--muted);
    font-size: 0.65em;
    font-weight: 400;
    opacity: 0;
    text-decoration: none;
  }

  .prose :global(.heading-anchor::before) {
    content: '#';
  }

  .prose :global(:is(h1, h2, h3, h4):hover .heading-anchor),
  .prose :global(.heading-anchor:focus) {
    opacity: 1;
  }

  .prose :global(p) {
    margin-block: 1em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1.15em;
    padding-inline-start: 1.65rem;
    list-style-position: outside;
  }

  .prose :global(ul) {
    list-style-type: disc;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(ul ul) {
    list-style-type: circle;
  }

  .prose :global(ul ul ul) {
    list-style-type: square;
  }

  .prose :global(ol ol) {
    list-style-type: lower-alpha;
  }

  .prose :global(ol ol ol) {
    list-style-type: lower-roman;
  }

  .prose :global(li) {
    padding-inline-start: 0.18em;
  }

  .prose :global(li::marker) {
    color: var(--brand);
    font-weight: 650;
  }

  .prose :global(li + li) {
    margin-top: 0.42em;
  }

  .prose :global(li > :is(ul, ol)) {
    margin-block: 0.5em;
  }

  .prose :global(li > p) {
    margin-block: 0.55em;
  }

  .prose :global(a) {
    color: var(--brand);
  }

  .prose :global(p:has(> a:only-child > img)) {
    display: flow-root;
  }

  .prose :global(p > a:only-child:has(> img)) {
    display: block;
    width: fit-content;
    max-width: 100%;
    border-radius: 0.25rem;
  }

  .prose :global(p > a:only-child:has(> img):focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }

  .prose :global(p > a:only-child > img) {
    float: none;
    margin-inline: 0;
  }

  .prose :global(blockquote) {
    margin: 1.55em 0;
    border-left: 3px solid var(--brand);
    border-radius: 0 0.55rem 0.55rem 0;
    padding: 0.8rem 1.1rem;
    background: var(--surface);
    color: var(--text-soft);
  }

  .prose :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .prose :global(hr) {
    margin: 2.75rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .prose :global(:not(pre) > code) {
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.1em 0.34em;
    background: var(--tag);
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .prose :global(pre:not(.mermaid)) {
    position: relative;
    max-width: 100%;
    margin: 1.6em 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    padding: 2.8rem 1.2rem 1.2rem;
    background: var(--code);
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    display: block;
    min-width: 0;
    overflow-x: auto;
    scrollbar-gutter: stable;
  }

  .prose :global(.code-language) {
    position: absolute;
    top: 0.72rem;
    left: 1.2rem;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    line-height: 1.4;
    opacity: 0.62;
    pointer-events: none;
  }

  .prose :global(.copy-code) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 0.35rem;
    padding: 0.24rem 0.58rem;
    background: rgb(20 20 19 / 75%);
    color: #f0efe8;
    cursor: pointer;
    font-size: 0.72rem;
  }

  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 1.6em 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.55;
    scrollbar-gutter: stable;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.65rem 0.8rem;
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--surface-muted);
  }

  .prose :global(tbody tr:nth-child(even)) {
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }

  .prose :global(img),
  .prose :global(.notebook-html-output img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
  }

  .prose :global(.notebook-html-output) {
    max-width: 100%;
    overflow-x: auto;
  }

  .prose :global(.mermaid) {
    display: grid;
    min-height: 4rem;
    margin: 1.6em 0;
    place-items: center;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    padding: 1rem;
    background: var(--surface) !important;
    color: var(--text);
  }

  .post-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
  }

  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .post-navigation a {
    display: flex;
    min-height: 6rem;
    flex-direction: column;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    padding: 1rem;
    background: var(--surface);
    text-decoration: none;
  }

  .post-navigation a:last-child {
    text-align: right;
  }

  .post-navigation small {
    color: var(--muted);
  }

  @media (max-width: 64rem) {
    .post-shell {
      display: block;
      width: min(100% - 2rem, 48rem);
    }

    .toc {
      display: none;
    }

    .mobile-toc {
      display: block;
      margin: -1rem 0 2.25rem;
      border: 1px solid var(--border);
      border-radius: 0.65rem;
      background: var(--surface);
      color: var(--text-soft);
      font-size: 0.9rem;
    }

    .mobile-toc summary {
      padding: 0.8rem 1rem;
      color: var(--text);
      cursor: pointer;
      font-weight: 650;
    }

    .mobile-toc ol {
      margin: 0;
      padding: 0 1rem 1rem;
      list-style: none;
    }

    .mobile-toc li + li {
      margin-top: 0.5rem;
    }

    .mobile-toc li.nested {
      padding-left: 0.9rem;
    }

    .mobile-toc a {
      color: var(--text-soft);
      text-decoration: none;
    }
  }

  @media (max-width: 44rem) {
    .post-article {
      padding-top: 2.5rem;
    }

    .post-navigation {
      grid-template-columns: 1fr;
    }

    .prose :global(ul),
    .prose :global(ol) {
      padding-inline-start: 1.3rem;
    }

    .prose :global(pre:not(.mermaid)) {
      padding-inline: 1rem;
      font-size: 0.875rem;
    }

    .prose :global(table) {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  for (const pre of document.querySelectorAll<HTMLElement>('.prose pre:not(.mermaid)')) {
    const button = document.createElement('button');
    button.className = 'copy-code';
    button.type = 'button';
    button.textContent = '복사';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      await navigator.clipboard.writeText(code);
      button.textContent = '복사됨';
      window.setTimeout(() => (button.textContent = '복사'), 1400);
    });
    pre.append(button);
  }
</script>
