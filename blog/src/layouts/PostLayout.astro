---
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';
import type { MarkdownHeading } from 'astro';
import type { BlogEntry } from '../lib/content';
import BaseLayout from './BaseLayout.astro';
import Mermaid from '../components/Mermaid.astro';
import TopicBreadcrumbs from '../components/TopicBreadcrumbs.astro';
import { Badge } from '../components/starwind/badge';
import { Card, CardContent } from '../components/starwind/card';
import {
  Collapsible,
  CollapsibleContent,
  CollapsibleTrigger,
} from '../components/starwind/collapsible';
import { Prose } from '../components/starwind/prose';
import { Separator } from '../components/starwind/separator';
import { entryTopicBreadcrumbs, entryUrl, tagUrl } from '../lib/content';

interface Props {
  entry: BlogEntry;
  entries: BlogEntry[];
  headings: MarkdownHeading[];
  previous?: BlogEntry;
  next?: BlogEntry;
}

const { entry, entries, headings, previous, next } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const topicBreadcrumbs = entryTopicBreadcrumbs(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? entry.data.summary}
  entries={entries}
  canonical={entry.data.canonical}
  type="article"
>
  <div class="mx-auto grid w-[min(calc(100%-2rem),77rem)] grid-cols-1 justify-center gap-16 lg:grid-cols-[minmax(0,48rem)_15rem]">
    <article class="min-w-0 pt-10 lg:pt-16">
      <header class="mb-12 border-b pb-8">
        <TopicBreadcrumbs items={topicBreadcrumbs} />
        <h1
          class="my-3 text-[clamp(2.15rem,5.6vw,3.65rem)] leading-[1.1] font-semibold tracking-[-0.042em] [overflow-wrap:break-word] [word-break:keep-all]"
          data-pagefind-meta="title"
        >{entry.data.title}</h1>
        <p class="text-lg leading-7 text-muted-foreground">{entry.data.summary}</p>
        <div class="mt-4 flex gap-2 text-sm text-muted-foreground">
          <time datetime={entry.data.date.toISOString()}>
            {entry.data.date.toLocaleDateString('ko-KR', { dateStyle: 'long' })}
          </time>
        </div>
      </header>

      {toc.length > 0 && (
        <Collapsible class="group mb-9 rounded-xl border bg-card lg:hidden" data-pagefind-ignore>
          <CollapsibleTrigger class="flex w-full items-center justify-between px-4 py-3 text-left font-semibold">
            목차
            <ChevronDown class="size-4 transition-transform group-data-[state=open]:rotate-180" aria-hidden="true" />
          </CollapsibleTrigger>
          <CollapsibleContent>
            <ol class="grid list-none gap-2 px-4 pb-4 text-sm text-muted-foreground">
              {toc.map((heading) => (
                <li class:list={{ 'pl-4': heading.depth === 3 }}>
                  <a class="no-underline hover:text-primary-accent" href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </CollapsibleContent>
        </Collapsible>
      )}

      <Prose class="blog-prose" data-pagefind-body>
        <slot />
      </Prose>

      <footer class="mt-16">
        <Separator />
        <div class="mt-5 flex flex-wrap gap-2" aria-label="태그">
          {entry.data.tags.map((tag) => (
            <Badge href={tagUrl(tag)} tone="primary" appearance="soft" size="sm">#{tag}</Badge>
          ))}
        </div>
        <nav class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="이전과 다음 글">
          {previous ? (
            <a class="group block no-underline" rel="prev" href={entryUrl(previous)}>
              <Card class="min-h-24 justify-center transition-colors group-hover:border-primary/35">
                <CardContent>
                  <small class="text-muted-foreground">이전 글</small>
                  <span class="mt-1 block group-hover:text-primary-accent">← {previous.data.title}</span>
                </CardContent>
              </Card>
            </a>
          ) : <span />}
          {next ? (
            <a class="group block no-underline" rel="next" href={entryUrl(next)}>
              <Card class="min-h-24 justify-center text-right transition-colors group-hover:border-primary/35">
                <CardContent>
                  <small class="text-muted-foreground">다음 글</small>
                  <span class="mt-1 block group-hover:text-primary-accent">{next.data.title} →</span>
                </CardContent>
              </Card>
            </a>
          ) : <span />}
        </nav>
      </footer>
    </article>

    {toc.length > 0 && (
      <aside class="sticky top-24 hidden max-h-[calc(100vh-8rem)] self-start overflow-auto border-l pl-4 text-sm leading-snug text-muted-foreground lg:block" aria-label="목차" data-pagefind-ignore>
        <strong class="text-foreground">목차</strong>
        <ol class="mt-3 grid list-none gap-2 p-0">
          {toc.map((heading) => (
            <li class:list={{ 'pl-3': heading.depth === 3 }}>
              <a class="no-underline hover:text-primary-accent" href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>

  <Mermaid />
</BaseLayout>

<script>
  for (const pre of document.querySelectorAll<HTMLElement>('.blog-prose pre:not(.mermaid)')) {
    const button = document.createElement('button');
    button.className = 'copy-code';
    button.type = 'button';
    button.textContent = '복사';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      await navigator.clipboard.writeText(code);
      button.textContent = '복사됨';
      window.setTimeout(() => (button.textContent = '복사'), 1400);
    });
    pre.append(button);
  }
</script>
