---
import { withBase } from '../lib/url';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from './starwind/breadcrumb';

interface Item {
  name: string;
  url: string;
}

interface Props {
  items: Item[];
  current?: boolean;
}

const { items, current = false } = Astro.props;
---

<Breadcrumb class="mb-5 overflow-x-auto" aria-label="주제 경로">
  <BreadcrumbList class="w-max max-w-full flex-nowrap text-xs">
    <BreadcrumbItem><BreadcrumbLink href={withBase()}>홈</BreadcrumbLink></BreadcrumbItem>
    {items.map((item, index) => (
      <>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          {current && index === items.length - 1
            ? <BreadcrumbPage>{item.name}</BreadcrumbPage>
            : <BreadcrumbLink href={item.url}>{item.name}</BreadcrumbLink>}
        </BreadcrumbItem>
      </>
    ))}
  </BreadcrumbList>
</Breadcrumb>
