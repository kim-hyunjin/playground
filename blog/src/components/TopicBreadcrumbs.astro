---
import { withBase } from '../lib/url';

interface Item {
  name: string;
  url: string;
}

interface Props {
  items: Item[];
  current?: boolean;
}

const { items, current = false } = Astro.props;
---

<nav class="topic-breadcrumbs" aria-label="주제 경로">
  <ol>
    <li><a href={withBase()}>홈</a></li>
    {items.map((item, index) => (
      <li>
        <span aria-hidden="true">/</span>
        {current && index === items.length - 1
          ? <span aria-current="page">{item.name}</span>
          : <a href={item.url}>{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .topic-breadcrumbs {
    margin: 0 0 1.25rem;
    overflow-x: auto;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .topic-breadcrumbs ol,
  .topic-breadcrumbs li {
    display: flex;
    align-items: center;
  }

  .topic-breadcrumbs ol {
    width: max-content;
    max-width: 100%;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-breadcrumbs li {
    gap: 0.4rem;
  }

  .topic-breadcrumbs a {
    color: var(--brand);
    font-weight: 650;
    text-decoration: none;
  }

  .topic-breadcrumbs [aria-current='page'] {
    color: var(--text);
    font-weight: 650;
  }
</style>
