---
import {
  Pagination as StarwindPagination,
  PaginationContent,
  PaginationItem,
  PaginationNext,
  PaginationPrevious,
} from './starwind/pagination';

interface Props {
  current: number;
  total: number;
  getUrl: (page: number) => string;
}

const { current, total, getUrl } = Astro.props;
---

{total > 1 && (
  <StarwindPagination class="mt-10 border-t pt-4" aria-label="페이지">
    <PaginationContent class="grid w-full grid-cols-[1fr_auto_1fr]">
      <PaginationItem>
        {current > 1 && (
          <PaginationPrevious href={getUrl(current - 1)} rel="prev">이전</PaginationPrevious>
        )}
      </PaginationItem>
      <PaginationItem class="flex items-center px-3 text-sm text-muted-foreground">
        <span aria-current="page">{current} / {total}</span>
      </PaginationItem>
      <PaginationItem class="justify-self-end">
        {current < total && (
          <PaginationNext href={getUrl(current + 1)} rel="next">다음</PaginationNext>
        )}
      </PaginationItem>
    </PaginationContent>
  </StarwindPagination>
)}
