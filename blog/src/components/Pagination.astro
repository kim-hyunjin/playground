---
interface Props {
  current: number;
  total: number;
  getUrl: (page: number) => string;
}

const { current, total, getUrl } = Astro.props;
---

{total > 1 && (
  <nav class="pagination" aria-label="페이지">
    {current > 1 ? <a rel="prev" href={getUrl(current - 1)}>← 이전</a> : <span />}
    <span>{current} / {total}</span>
    {current < total ? <a rel="next" href={getUrl(current + 1)}>다음 →</a> : <span />}
  </nav>
)}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .pagination > :last-child {
    justify-self: end;
  }
</style>
