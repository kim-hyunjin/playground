---
import { withBase } from '../lib/url';
---

<footer class="site-footer" data-pagefind-ignore>
  <div>
    <p>배운 것을 설명하며 더 단단하게 이해합니다.</p>
    <nav aria-label="푸터 탐색">
      <a href={withBase('rss.xml')}>RSS</a>
      <a href={withBase('sitemap/')}>Sitemap</a>
      <a href="https://github.com/kim-hyunjin" rel="me">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    background: var(--surface-muted);
    color: var(--text-soft);
  }

  .site-footer > div {
    display: flex;
    width: min(100% - 2rem, 76rem);
    min-height: 7rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer nav {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 44rem) {
    .site-footer > div {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
