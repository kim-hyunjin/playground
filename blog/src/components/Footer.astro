---
import { withBase } from '../lib/url';
---

<footer class="mt-20 border-t bg-muted text-muted-foreground" data-pagefind-ignore>
  <div class="mx-auto flex min-h-28 w-[min(calc(100%-2rem),76rem)] flex-col items-start justify-center gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p>배운 것을 설명하며 더 단단하게 이해합니다.</p>
    <nav class="flex gap-4 text-sm" aria-label="푸터 탐색">
      <a class="hover:text-primary-accent" href={withBase('rss.xml')}>RSS</a>
      <a class="hover:text-primary-accent" href={withBase('sitemap/')}>Sitemap</a>
      <a class="hover:text-primary-accent" href="https://github.com/kim-hyunjin" rel="me">GitHub</a>
    </nav>
  </div>
</footer>
