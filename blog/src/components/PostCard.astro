---
import type { BlogEntry } from '../lib/content';
import { entryTopicBreadcrumbs, entryUrl, readingMinutes, tagUrl } from '../lib/content';

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const topics = entryTopicBreadcrumbs(entry);
---

<article class="post-card">
  <div class="post-card-meta">
    <span class="post-card-topic-path" aria-label="주제 경로">
      {topics.map((topic, index) => (
        <>
          {index > 0 && <span aria-hidden="true">/</span>}
          <a href={topic.url}>{topic.name}</a>
        </>
      ))}
    </span>
    <span aria-hidden="true">·</span>
    <time datetime={entry.data.date.toISOString()}>
      {entry.data.date.toLocaleDateString('ko-KR')}
    </time>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes(entry)}분</span>
  </div>
  <h2><a href={entryUrl(entry)}>{entry.data.title}</a></h2>
  <p>{entry.data.summary}</p>
  <ul class="tag-list" aria-label="태그">
    {entry.data.tags.slice(0, 4).map((tag) => (
      <li><a href={tagUrl(tag)}>#{tag}</a></li>
    ))}
  </ul>
</article>

<style>
  .post-card {
    display: flex;
    min-height: 15.5rem;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    padding: 1.35rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .post-card-meta a {
    color: var(--brand);
    font-weight: 700;
    text-decoration: none;
  }

  .post-card-topic-path {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .post-card h2 {
    margin: 0.8rem 0 0.55rem;
    font-size: 1.3rem;
    letter-spacing: -0.035em;
    line-height: 1.3;
  }

  .post-card h2 a {
    text-decoration: none;
  }

  .post-card > p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-soft);
    font-size: 0.9rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
