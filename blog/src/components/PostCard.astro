---
import type { BlogEntry } from '../lib/content';
import { entryTopicBreadcrumbs, entryUrl, tagUrl } from '../lib/content';
import { Badge } from './starwind/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from './starwind/card';

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const topics = entryTopicBreadcrumbs(entry);
---

<Card class="h-full min-h-64 shadow-xs transition-colors hover:border-primary/35">
  <CardHeader>
    <div class="mb-2 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
      <span class="inline-flex flex-wrap gap-1" aria-label="주제 경로">
        {topics.map((topic, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            <a class="font-bold text-primary no-underline hover:text-primary-accent" href={topic.url}>{topic.name}</a>
          </>
        ))}
      </span>
      <span aria-hidden="true">·</span>
      <time datetime={entry.data.date.toISOString()}>
        {entry.data.date.toLocaleDateString('ko-KR')}
      </time>
    </div>
    <CardTitle class="text-[1.3rem] tracking-[-0.035em]">
      <a class="no-underline hover:text-primary-accent" href={entryUrl(entry)}>{entry.data.title}</a>
    </CardTitle>
    <CardDescription class="line-clamp-3 leading-relaxed">{entry.data.summary}</CardDescription>
  </CardHeader>
  <CardContent class="mt-auto flex flex-wrap gap-1.5 pt-2" aria-label="태그">
    {entry.data.tags.slice(0, 4).map((tag) => (
      <Badge href={tagUrl(tag)} tone="primary" appearance="soft" size="sm">#{tag}</Badge>
    ))}
  </CardContent>
</Card>
