---
import type { BlogEntry } from '../lib/content';
import { entryTopicPath, entryUrl, topicUrl } from '../lib/content';
import type { TopicNode } from '../lib/topics';
import { Badge } from './starwind/badge';

interface Props {
  topic: TopicNode;
  entries: BlogEntry[];
}

const { topic, entries } = Astro.props;
const directEntries = entries.filter((entry) => entryTopicPath(entry) === topic.path);
---

<div class="sitemap-topic">
  <div class="flex items-baseline justify-between gap-4">
    <a class="font-bold no-underline hover:text-primary-accent hover:underline" href={topicUrl(topic.path)}>{topic.name}</a>
    <Badge variant="outline" size="sm">{topic.count}개</Badge>
  </div>

  {directEntries.length > 0 && (
    <ul class="mt-3 grid list-none gap-1.5 pl-4">
      {directEntries.map((entry) => (
        <li class="relative before:absolute before:-left-3.5 before:text-muted-foreground before:content-['–']">
          <a class="text-sm text-muted-foreground no-underline hover:text-primary-accent hover:underline" href={entryUrl(entry)}>{entry.data.title}</a>
        </li>
      ))}
    </ul>
  )}

  {topic.children.length > 0 && (
    <ul class="mt-4 grid list-none gap-4 border-l pl-4">
      {topic.children.map((child) => (
        <li><Astro.self topic={child} entries={entries} /></li>
      ))}
    </ul>
  )}
</div>
