---
import { Alert, AlertTitle } from './starwind/alert';

interface Props {
  title?: string;
}

const { title = '참고' } = Astro.props;
---

<Alert variant="primary" class="my-5 border-l-[3px] bg-card" role="note">
  <AlertTitle>{title}</AlertTitle>
  <div class="leading-relaxed [&>:last-child]:mb-0">
    <slot />
  </div>
</Alert>
