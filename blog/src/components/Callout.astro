---
interface Props {
  title?: string;
}

const { title = '참고' } = Astro.props;
---

<aside class="callout">
  <strong>{title}</strong>
  <slot />
</aside>

<style>
  .callout {
    margin-block: 1.25rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
  }

  .callout :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
