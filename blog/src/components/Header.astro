---
import Menu from '@tabler/icons/outline/menu-2.svg';
import Search from '@tabler/icons/outline/search.svg';
import type { BlogEntry } from '../lib/content';
import { collectCategories, topicUrl } from '../lib/content';
import { withBase } from '../lib/url';
import { Button } from './starwind/button';
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from './starwind/sheet';
import { ThemeToggle } from './starwind/theme-toggle';

interface Props {
  entries: BlogEntry[];
}

const { entries } = Astro.props;
const categories = collectCategories(entries);
---

<header
  class="sticky top-0 z-40 border-b bg-card/90 backdrop-blur-md"
  data-pagefind-ignore
>
  <div class="mx-auto flex min-h-16 w-[min(calc(100%-2rem),84rem)] items-center gap-5">
    <a
      class="inline-flex shrink-0 items-center gap-2 font-bold text-primary no-underline"
      href={withBase()}
      aria-label="hyunjin.log 홈"
    >
      <span
        class="grid size-7 place-items-center rounded-full bg-primary font-mono text-[0.66rem] tracking-normal text-primary-foreground"
        aria-hidden="true"
      >hj</span>
      <span>hyunjin.log</span>
    </a>

    <nav class="hidden min-w-0 flex-1 items-center justify-center gap-[clamp(0.65rem,1.6vw,1.5rem)] lg:flex" aria-label="주요 탐색">
      {categories.map((category) => (
        <a
          class="whitespace-nowrap text-sm font-semibold text-muted-foreground no-underline hover:text-primary-accent"
          href={topicUrl(category.slug)}
        >{category.name}</a>
      ))}
    </nav>

    <div class="ml-auto flex shrink-0 gap-1">
      <Button as="a" href={withBase('search/')} variant="ghost" size="icon" aria-label="검색">
        <Search aria-hidden="true" />
      </Button>
      <ThemeToggle variant="default" size="md" class="w-11" ariaLabel="다크 모드 전환" />

      <Sheet>
        <SheetTrigger
          class="inline-flex size-11 items-center justify-center rounded-md transition-colors hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50 focus-visible:outline-none lg:hidden"
          aria-label="메뉴 열기"
        >
          <Menu class="size-5" aria-hidden="true" />
        </SheetTrigger>
        <SheetContent class="overflow-y-auto" aria-label="모바일 탐색" closeLabel="메뉴 닫기">
          <SheetHeader>
            <SheetTitle>hyunjin.log</SheetTitle>
            <SheetDescription>주제별 글을 탐색합니다.</SheetDescription>
          </SheetHeader>
          <nav class="grid gap-1 px-4 pb-6" aria-label="모바일 탐색">
            <Button as="a" href={withBase()} variant="ghost" class="justify-between">홈</Button>
            {categories.map((category) => (
              <Button as="a" href={topicUrl(category.slug)} variant="ghost" class="justify-between">
                <span>{category.name}</span>
                <span class="text-sm text-muted-foreground">{category.count}</span>
              </Button>
            ))}
            <Button as="a" href={withBase('tags/')} variant="ghost" class="justify-start">태그</Button>
            <Button as="a" href={withBase('search/')} variant="ghost" class="justify-start">검색</Button>
          </nav>
        </SheetContent>
      </Sheet>
    </div>
  </div>
</header>
