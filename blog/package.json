{
  "name": "hyunjin-log",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/convert-notebooks.mjs && astro dev",
    "preview": "astro preview",
    "clean": "node scripts/clean.mjs",
    "convert:notebooks": "node scripts/convert-notebooks.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "check": "node scripts/convert-notebooks.mjs && astro check && node scripts/verify-content.mjs",
    "test": "vitest run",
    "lint": "npm run check",
    "build:site": "node scripts/clean.mjs && node scripts/convert-notebooks.mjs && astro build && pagefind --site dist && node scripts/finalize-build.mjs && node scripts/verify-dist.mjs",
    "build": "npm run check && npm run test && npm run build:site",
    "publish": "node scripts/publish.mjs",
    "publish:dry-run": "node scripts/publish.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "mermaid": "11.16.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "sanitize-html": "2.17.6",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "24.10.1",
    "@types/sanitize-html": "2.16.1",
    "gh-pages": "6.3.0",
    "gray-matter": "4.0.3",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
