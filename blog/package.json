{
  "name": "hyunjin-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/convert-notebooks.ts && astro dev",
    "preview": "astro preview",
    "clean": "node scripts/clean.ts",
    "convert:notebooks": "node scripts/convert-notebooks.ts",
    "verify:content": "node scripts/verify-content.ts",
    "typecheck": "tsc --noEmit && astro check",
    "check": "node scripts/convert-notebooks.ts && pnpm run typecheck && node scripts/verify-content.ts",
    "test": "vitest run",
    "lint": "pnpm run check",
    "build:site": "node scripts/clean.ts && node scripts/convert-notebooks.ts && astro build && pagefind --site dist && node scripts/finalize-build.ts && node scripts/verify-dist.ts",
    "build": "pnpm run check && pnpm run test && pnpm run build:site",
    "publish": "node scripts/publish.ts",
    "publish:dry-run": "node scripts/publish.ts --dry-run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "mermaid": "11.16.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@shikijs/types": "4.3.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/sanitize-html": "2.16.1",
    "gh-pages": "6.3.0",
    "gray-matter": "4.0.3",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "4.1.10"
  }
}
