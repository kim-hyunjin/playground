{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baseball Manager",
  "version": "0.1.0",
  "identifier": "com.ygaso.baseballmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Baseball Manager",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Game",
    "shortDescription": "야구 감독 시뮬레이션 게임",
    "longDescription": "구단 운영, 선수 육성, 경기 작전을 경험하는 야구 감독 시뮬레이션 게임입니다."
  }
}
